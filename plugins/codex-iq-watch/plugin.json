{
  "manifestVersion": 1,
  "name": "codex-iq-watch",
  "displayName": "Codex 降智监控",
  "publisher": "xunzhimeng",
  "version": "0.2.2",
  "description": "按账号观察上游过载、缓存命中骤降与首 token 变慢等降智信号，持续命中时通过 Webhook 或邮件 HTTP API 告警。",
  "license": "MIT",
  "author": "xunzhimeng",
  "engines": {
    "codex-proxy-rs": ">=3.15.0, <4.0.0"
  },
  "main": "bin/codex-iq-watch",
  "runtime": "trustedProcess",
  "contributes": {
    "request_lifecycle": {},
    "usage": {},
    "scheduler": {},
    "management": {}
  },
  "permissions": [
    "requests",
    "network",
    "accounts",
    "models",
    "public_endpoints"
  ],
  "configurationSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "为 false 时仍统计信号但不发送通知"
      },
      "watch_providers": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 64
        },
        "default": [
          "openai"
        ],
        "description": "只监控这些 Provider 的请求；留空数组表示全部"
      },
      "window_ms": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 3600000,
        "default": 900000,
        "description": "事件保留时长（毫秒），默认 15 分钟；判定采样上限另由 sample_requests 控制"
      },
      "sample_requests": {
        "type": "integer",
        "minimum": 4,
        "maximum": 40,
        "default": 15,
        "description": "判定只用最近 N 次请求的信号做采样，避免时间窗口内老事件稀释当前状态"
      },
      "min_signaled_requests": {
        "type": "integer",
        "minimum": 2,
        "maximum": 20,
        "default": 2,
        "description": "最近采样请求内带信号的请求数达到该值才考虑告警"
      },
      "min_signal_kinds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5,
        "default": 2,
        "description": "最近采样内至少出现多少种不同信号才判定降智；缓存骤降需与慢响应同时存在才计入"
      },
      "consecutive_triggers": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "default": 2,
        "description": "判定结论连续出现多少次才真正告警"
      },
      "cooldown_ms": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 86400000,
        "default": 1800000,
        "description": "同一账号两次告警的最小间隔（毫秒），默认 30 分钟"
      },
      "latency_ms": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 600000,
        "default": 10000,
        "description": "（已废弃，仅兼容旧配置）整体耗时阈值；慢响应只看首 token 耗时"
      },
      "first_token_ms": {
        "type": "integer",
        "minimum": 1000,
        "maximum": 600000,
        "default": 10000,
        "description": "网关到上游首 token 耗时超过该值记为响应变慢信号；客户端侧看到的首字时间还包含网关处理，两者不同"
      },
      "cache_min_input_tokens": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000000,
        "default": 1000,
        "description": "输入达到该 token 数才参与缓存命中骤降判定；骤降需窗口内先命中后连续 ≥2 次大输入零命中"
      },
      "alert_message": {
        "type": "string",
        "default": "检测到该账号持续出现降智特征，建议切换账号或稍后再用。",
        "description": "附加在通知正文中的提示语"
      },
      "schedule_exclude_degraded": {
        "type": "boolean",
        "default": false,
        "description": "账号调度时排除已判定降智的账号；被排除账号不再收到请求，需在状态页手动恢复才能重新参与调度"
      },
      "schedule_all_degraded": {
        "type": "string",
        "enum": [
          "delegate",
          "reject"
        ],
        "default": "delegate",
        "description": "候选账号全部降智时的处理：delegate 交回内置调度（不断流），reject 拒绝该请求"
      },
      "webhook_url": {
        "type": "string",
        "default": "",
        "description": "通知 Webhook 地址（HTTPS）；为空则不发送 Webhook"
      },
      "webhook_format": {
        "type": "string",
        "enum": [
          "generic",
          "wecom",
          "dingtalk",
          "feishu",
          "slack",
          "bark"
        ],
        "default": "generic",
        "description": "Webhook 载荷格式：generic 为结构化 JSON，其余为常见机器人格式"
      },
      "email_url": {
        "type": "string",
        "default": "",
        "description": "邮件 HTTP API 地址（如 Resend/Postmark/SendGrid 或自建邮件网关）；为空则不发送邮件"
      },
      "email_format": {
        "type": "string",
        "enum": [
          "generic",
          "resend",
          "postmark",
          "sendgrid"
        ],
        "default": "generic",
        "description": "邮件 API 载荷格式"
      },
      "email_from": {
        "type": "string",
        "default": "",
        "description": "发件人，按所选邮件 API 要求填写"
      },
      "email_to": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 256
        },
        "maxItems": 8,
        "default": [],
        "description": "收件人列表"
      },
      "email_subject_template": {
        "type": "string",
        "default": "[降智告警] {{account}} 信号 {{count}} 项",
        "description": "邮件主题模板，支持 {{title}} {{account}} {{detail}} {{count}} 占位"
      },
      "email_body_template": {
        "type": "string",
        "default": "{\"title\": \"{{title}}\", \"detail\": \"{{detail}}\", \"account\": \"{{account}}\", \"occurred_at\": \"{{occurred_at}}\"}",
        "description": "generic 邮件格式的请求体模板，{{...}} 占位会被转义后替换为 JSON 字符串"
      }
    }
  },
  "secretFields": [
    "webhook_auth_header",
    "email_auth_header"
  ],
  "resources": {
    "ui/index.html": "text/html",
    "ui/app.js": "text/javascript",
    "ui/style.css": "text/css",
    "ui/icon.svg": "image/svg+xml"
  },
  "icon": "ui/icon.svg",
  "state": [
    {
      "namespace": "watch",
      "schemaVersion": 1,
      "schema": {
        "type": "object"
      },
      "maximumRecords": 256,
      "maximumBytes": 4194304,
      "maximumValueBytes": 262144
    }
  ]
}
